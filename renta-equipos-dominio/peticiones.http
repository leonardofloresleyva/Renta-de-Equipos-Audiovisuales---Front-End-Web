  "nombre": "Administrador Actualizado",
  "telefono": "6440000099"
}

### 28. Eliminar administrador (el recién registrado por el request 26)
DELETE {{baseUrl}}/usuarios/administradores/{{registrarAdmin.response.body.$.data.id}}
Authorization: Bearer {{adminToken}}
Accept: application/json

