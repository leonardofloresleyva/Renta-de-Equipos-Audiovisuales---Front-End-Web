# Copia este archivo como .env y cambia TU_PASSWORD por la contrasena
# de root de tu MySQL. La base "renta-equipos" no hace falta crearla a
# mano: `prisma migrate dev` la crea si no existe.
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/renta-equipos"

# Quien tenga este secreto puede firmar tokens validos. Cambialo.
JWT_SECRET=""
